# DobDex API (api/server.js) — solo nombres; los valores nunca se versionan.
# Dev (S22): `devenv up dobhooks` (port-forward localhost:55403, Postgres `dob` de la devbox) +
#            `devenv env dobhooks` en la raíz → .env.local (600), que server.js lee si no hay api/.env.
# Prod: api/.env solo en el server (nunca en un PC).

# Base de Dober-MVP (dev: mvp)
MVP_DB_HOST=
MVP_DB_PORT=
MVP_DB_NAME=
MVP_DB_USER=
MVP_DB_PASS=

# Base del validator (dev: validator)
VAL_DB_HOST=
VAL_DB_PORT=
VAL_DB_NAME=
VAL_DB_USER=
VAL_DB_PASS=

# Base propia del DEX; HOST/PORT/USER/PASS caen a los MVP_DB_* si faltan
DEX_DB_HOST=
DEX_DB_PORT=
DEX_DB_NAME=
DEX_DB_USER=
DEX_DB_PASS=

DEX_API_PORT=
DEX_RPC_1301=
# Bearer de /api/oracle-updates (apagado si falta)
DEX_INGEST_TOKEN=
RL_READ_PER_MIN=
RL_WRITE_PER_MIN=
